# --- Local development (SQLite) ---
DATABASE_URL=sqlite:///instance/school_schedule.db
SECRET_KEY=dev-local-secret
# false for http://127.0.0.1 — true behind HTTPS / Cloudflare Tunnel
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin12345

# --- Docker / production (PostgreSQL) ---
# On the server: copy to .env and set strong secrets.
# HTTP_PORT=80
# Local Docker: HTTP_PORT=8000 → http://localhost:8000
# POSTGRES_USER=schedule
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=school_schedule
# SECRET_KEY=change-me-in-production
# COOKIE_SECURE=true
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
# BOOTSTRAP_ADMIN_PASSWORD=strong-password
# Compose builds DATABASE_URL from POSTGRES_* for api/worker.
# Local Postgres outside Docker:
# DATABASE_URL=postgresql+psycopg://schedule:change-me@localhost:5432/school_schedule

# Queue: docker compose --profile queue up -d
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1
# SOLVER_TIME_LIMIT_SEC=90
# Worker container: SOLVER_NUM_WORKERS should equal SOLVER_CPUS.
# SOLVER_CPUS=4
# SOLVER_MEM_LIMIT=4g
# SOLVER_NUM_WORKERS=4
# On a 2-vCPU host set SOLVER_CPUS=2 and SOLVER_NUM_WORKERS=2.
# On 16 GB RAM you can raise SOLVER_MEM_LIMIT=6g.

# Qwen (DashScope OpenAI-compatible). Used only to phrase validator facts
# on the schedule "why" panel. If unset, the panel still works with template text.
# QWEN_API_KEY=
# DASHSCOPE_API_KEY=sk-bc439a49a48144c28b4de473f9c07b7b
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus
